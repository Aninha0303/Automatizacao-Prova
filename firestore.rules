rules_version = '2';

// Regras do Firestore do Corrige+.
// Cada registro guarda o professorId de quem criou: só essa pessoa lê e altera.
// Sem isso, qualquer pessoa logada conseguiria ver as turmas e as notas
// de outro professor, mesmo que o app filtre pela tela.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // O documento pertence ao professor logado.
    function donoDosDados(dados) {
      return logado() && dados.professorId == request.auth.uid;
    }

    // Perfil do professor: só a própria pessoa lê e escreve.
    match /professores/{professorId} {
      allow read, write: if logado() && professorId == request.auth.uid;
    }

    // Turmas, alunos, questões e provas: dono cria, lê, altera e apaga.
    match /turmas/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data);
      allow update, delete:
        if donoDosDados(resource.data) && donoDosDados(request.resource.data);
    }

    match /alunos/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data);
      allow update, delete:
        if donoDosDados(resource.data) && donoDosDados(request.resource.data);
    }

    match /questoes/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data);
      allow update, delete:
        if donoDosDados(resource.data) && donoDosDados(request.resource.data);
    }

    match /provas/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data);
      allow update, delete:
        if donoDosDados(resource.data) && donoDosDados(request.resource.data);
    }

    // Correções: a nota do aluno só aparece para o professor que a lançou.
    match /correcoes/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data);
      allow update, delete:
        if donoDosDados(resource.data) && donoDosDados(request.resource.data);
    }

    // Qualquer outra coleção fica fechada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
